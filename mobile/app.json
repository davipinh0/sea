{
  "expo": {
    "name": "SEA",
    "slug": "sea-prototipo",
    "version": "1.36.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.sea.prototipo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "br.sea.prototipo",
      "versionCode": 13,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-splash-screen",
      "./plugins/chainway-scanner",
      "./plugins/with-cleartext-traffic"
    ]
  }
}
