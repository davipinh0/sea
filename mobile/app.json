{
  "expo": {
    "name": "SEA",
    "slug": "sea-prototipo",
    "version": "1.36.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.sea.prototipo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F26522"
      },
      "package": "br.sea.prototipo",
      "versionCode": 15,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA",
        "android.permission.CAMERA",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "O SEA usa a câmera para ler códigos de barras de ordens, materiais e endereços.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-cleartext-traffic",
      [
        "expo-notifications",
        {
          "color": "#F26522",
          "sounds": [
            "./assets/sea_aviso.wav"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O SEA usa o Face ID para desbloquear o app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8bcaf915-0743-437b-8e9d-f54e555efbfb"
      }
    },
    "owner": "davipinh0"
  }
}
